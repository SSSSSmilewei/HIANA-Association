{
  "name": "hiana-association",
  "private": true,
  "type": "module",
  "description": "智慧算法网络协会学习平台：选课目录、拍照签到签退、统一热力图、公告与比赛、管理后台。运行在 Cloudflare Workers + D1。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "dev:bun": "node scripts/build.mjs && bun scripts/dev.ts",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "test": "bun test",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "typescript": "6.0.3",
    "wrangler": "^4.154.0"
  }
}
