{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiana-association",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "upload_source_maps": true,
  // 前端由 scripts/build.mjs 打包到 dist/client；/api/* 先交给 Worker 处理
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 自定义域名：部署时自动绑定（域名需要已经在这个 Cloudflare 账号下）
  "routes": [{ "pattern": "study.shanmoew-denied.win", "custom_domain": true }],
  // 保留 *.workers.dev 地址作为备用（国内经常打不开，学员请用上面的域名）
  "workers_dev": true,
  // 数据库已在 Cloudflare 上建好（亚太区）。fork 本项目自己部署时删掉 database_id，第一次部署会自动新建
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiana-association-db",
      "database_id": "bae83829-31fb-402a-869e-5b01507cdd30"
    }
  ],
  // 公告配图图床：公开读的 R2 存储桶（在桶设置里绑定自定义域名）。启用时取消注释，并设置变量 IMAGE_BASE_URL=https://你的图床域名
  // "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "你的桶名" }],
  // 每 5 分钟把攒下的通知合并成一条发到微信；每晚 23:30（北京时间，即 UTC 15:30）同步各平台热力图
  "triggers": { "crons": ["*/5 * * * *", "30 15 * * *"] },
  "vars": {
    "AI_PROVIDER": "openai",
    "AI_BASE_URL": "https://api.deepseek.com",
    "AI_MODEL": "deepseek-chat"
  }
  // 密钥用 `wrangler secret put` 或在 Cloudflare 面板里设置，不要写在这里：
  // SESSION_SECRET, FIRST_ADMIN_CODE, AI_API_KEY, WXPUSHER_SPT, SERVERCHAN_KEY, SITE_URL, GITHUB_TOKEN
  // FIRST_ADMIN_CODE 只在系统里还没有管理员时有用：第一个管理员用它代替邀请码注册，之后可以删掉
}
