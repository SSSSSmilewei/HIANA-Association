# 复制成 .dev.vars 用于本地开发（不会提交到仓库）
SESSION_SECRET=把这里换成一长串随机字符
# 第一个管理员（学号 254030411）注册时代替邀请码用；已经有管理员后没用
FIRST_ADMIN_CODE=换成一串只有你知道的字符
# 大模型（OpenAI 兼容接口：DeepSeek、通义千问、Kimi、OpenRouter 都可以）
AI_PROVIDER=openai
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
# 微信通知（二选一，都填就都发）
WXPUSHER_SPT=
SERVERCHAN_KEY=
SITE_URL=http://localhost:8787

# 公告配图图床（R2 自定义域名，公开读）；桶在 wrangler.jsonc 的 r2_buckets 里绑定为 IMAGES
IMAGE_BASE_URL=
